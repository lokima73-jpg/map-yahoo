// Fonction serveur Vercel. Aucune clé API nécessaire.
// /api/data?part=price&range=1d | /api/data?part=news | /api/data?part=cal
const UA = {
  "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
  Accept: "application/json,text/xml,*/*",
};
const get = async (url, type = "json") => {
  const r = await fetch(url, { headers: UA, signal: AbortSignal.timeout(6000) });
  if (!r.ok) throw new Error(url + " " + r.status);
  return type === "json" ? r.json() : r.text();
};
const first = async (urls) => {
  let err;
  for (const u of urls) {
    try { return await get(u); } catch (e) { err = e; }
  }
  throw err;
};

// ---------- Prix ----------
const RANGES = { "1d": "5m", "5d": "15m", "1mo": "1h", "1y": "1d" };
const SYMBOLS = ["XAUUSD=X", "GC=F"]; // spot, puis future en secours

async function price(range) {
  if (!RANGES[range]) range = "1d";
  let lastErr;
  for (const sym of SYMBOLS) {
    try {
      const q = "/v8/finance/chart/" + encodeURIComponent(sym) + "?range=" + range + "&interval=" + RANGES[range];
      const j = await first(["https://query1.finance.yahoo.com" + q, "https://query2.finance.yahoo.com" + q]);
      const r = j.chart.result[0], m = r.meta, k = r.indicators.quote[0];
      const series = [];
      (r.timestamp || []).forEach((t, i) => { if (k.close[i] != null) series.push([t, k.close[i]]); });
      if (!series.length) throw new Error("pas de données");
      const last = series[series.length - 1];
      return {
        symbol: sym, range,
        price: m.regularMarketPrice ?? last[1],
        prev: m.chartPreviousClose ?? series[0][1],
        high: Math.max(...k.high.filter((v) => v != null)),
        low: Math.min(...k.low.filter((v) => v != null)),
        t: m.regularMarketTime ?? last[0],
        series,
      };
    } catch (e) { lastErr = e; }
  }
  throw lastErr;
}

// ---------- Actualités ----------
// [expression, points, thème]. Une actu doit atteindre 4 points pour être gardée (le hors-sujet disparaît).
const RULES = [
  [/\b(gold|xau|xauusd|bullion)\b|once d['’]or|cours de l['’]or|prix de l['’]or/i, 5, "Or"],
  [/\b(FOMC|Fed|Powell|Federal Reserve)\b|[Rr]ate (cuts?|hikes?)|[Ii]nterest rates?|taux directeurs?/, 4, "Fed"],
  [/\b(CPI|PCE|PPI|inflation)\b/i, 4, "Inflation"],
  [/\b(NFP|payrolls?|jobs report|unemployment|jobless)\b|emploi/i, 3, "Emploi"],
  [/\b(dollar|DXY|greenback)\b/i, 3, "Dollar"],
  [/\b(treasury|yields?)\b/i, 3, "Taux US"],
  [/\b(war|geopolitic\w*|tariffs?|sanctions?|ceasefire|Middle East|Ukraine|Iran|Israel|guerre)\b/i, 2, "Géopolitique"],
  [/\b(central banks?|ETF|safe[- ]haven|recession|GDP)\b|banques? centrales?/i, 2, "Macro"],
];
const BAD = /medal|olympi|gold coast|gold cup|pok[eé]mon|horoscope|giveaway|casino/i;

const dec = (s) => s.replace(/<!\[CDATA\[|\]\]>/g, "").replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&#0?39;|&apos;/g, "'").replace(/&amp;/g, "&").trim();
const tag = (x, n) => (x.match(new RegExp("<" + n + "[^>]*>([\\s\\S]*?)</" + n + ">")) || [])[1];
function rss(xml) {
  return [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].map((m) => {
    const x = m[1], s = dec(tag(x, "source") || "");
    let t = dec(tag(x, "title") || "");
    if (s && t.endsWith(" - " + s)) t = t.slice(0, -(s.length + 3));
    return { t, u: dec(tag(x, "link") || ""), s, ts: Date.parse(tag(x, "pubDate") || "") };
  });
}
const GN = (q, hl, gl, ceid) => "https://news.google.com/rss/search?q=" + encodeURIComponent(q) + "&hl=" + hl + "&gl=" + gl + "&ceid=" + ceid;
const YQ = ["gold price", "XAUUSD", "Federal Reserve", "US dollar", "inflation CPI", "Treasury yields", "central banks gold"];

async function news() {
  const sources = [
    ...YQ.map(async (q) => {
      const j = await get("https://query1.finance.yahoo.com/v1/finance/search?q=" + encodeURIComponent(q) + "&newsCount=15&quotesCount=0&listsCount=0");
      return (j.news || []).map((n) => ({ t: n.title, u: n.link, s: n.publisher, ts: n.providerPublishTime * 1000 }));
    }),
    get(GN('gold price OR XAUUSD OR "gold prices" when:2d', "en-US", "US", "US:en"), "text").then(rss),
    get(GN('"Federal Reserve" OR CPI OR "US dollar" when:1d', "en-US", "US", "US:en"), "text").then(rss),
    get(GN('"once d\'or" OR "cours de l\'or" when:2d', "fr", "FR", "FR:fr"), "text").then(rss),
  ];
  const all = (await Promise.allSettled(sources)).flatMap((r) => (r.status === "fulfilled" ? r.value : []));
  if (!all.length) throw new Error("aucune source");
  const now = Date.now(), seen = new Set(), out = [];
  for (const a of all) {
    if (!a.t || !/^https?:\/\//.test(a.u || "") || !a.ts || BAD.test(a.t)) continue;
    const key = a.t.toLowerCase().replace(/[^a-z0-9à-ÿ]/g, "").slice(0, 60);
    if (seen.has(key)) continue;
    seen.add(key);
    let b = 0;
    const k = [];
    for (const [re, w, name] of RULES) if (re.test(a.t)) { b += w; k.push(name); }
    const age = Math.max(0, (now - a.ts) / 36e5);
    if (b < 4 || age > 72) continue;
    out.push({
      t: a.t, u: a.u, s: a.s, ts: a.ts, k,
      i: b >= 9 ? "Fort" : b >= 6 ? "Moyen" : "Faible",
      r: b + 3 * Math.max(0, 1 - age / 24), // impact + fraîcheur
    });
  }
  return out.sort((x, y) => y.r - x.r).slice(0, 30).map(({ r, ...n }) => n);
}

// ---------- Calendrier ----------
async function cal() {
  const j = await get("https://nfs.faireconomy.media/ff_calendar_thisweek.json");
  return j
    .filter((e) => e.country === "USD" && (e.impact === "High" || e.impact === "Medium"))
    .map((e) => ({ ti: e.title, ts: Date.parse(e.date), imp: e.impact === "High" ? "Fort" : "Moyen", f: e.forecast || "", p: e.previous || "" }))
    .filter((e) => e.ts)
    .sort((a, b) => a.ts - b.ts);
}

// ---------- Réponse ----------
// Le cache du serveur protège les sources : peu importe le nombre de visiteurs, elles ne sont appelées que rarement.
const CACHE = { price: 20, news: 120, cal: 1800 };
module.exports = async (req, res) => {
  const part = req.query.part;
  if (!CACHE[part]) return res.status(400).json({ error: "part inconnu" });
  try {
    const data = part === "price" ? await price(String(req.query.range || "1d")) : part === "news" ? await news() : await cal();
    res.setHeader("Cache-Control", "public, max-age=0, s-maxage=" + CACHE[part] + ", stale-while-revalidate=" + CACHE[part] * 6);
    res.status(200).json(data);
  } catch (e) {
    res.setHeader("Cache-Control", "no-store");
    res.status(502).json({ error: "Source de données indisponible" });
  }
};
